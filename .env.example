# =============================================================================
# REGLA DE ORO: todo lo que empiece con VITE_ se publica en el JavaScript del
# navegador. Ahí SOLO van valores públicos. Las claves secretas van SIN prefijo
# y solo las leen las funciones serverless de /api.
# =============================================================================

# --- PÚBLICAS (frontend) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_GA_MEASUREMENT_ID=
VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# --- SOLO SERVIDOR (/api/*) ---
# Chatbot (cascada de proveedores)
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Cloudinary (solo si en el futuro se suben imágenes desde el servidor)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes permitidos para /api (separados por coma). Si se omite, se usan los del código.
ALLOWED_ORIGINS=https://www.agujasacupunturaperu.com,https://agujasacupunturaperu.com,https://agujas-acupuntura-peru.vercel.app

# (Opcional, recomendado) Rate limit global con Upstash Redis — plan gratuito
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
